# Local development settings. Copy to .env (ignored by git); never put credentials here.
# The app must work fully without these (the cloud is opt-in, ADR 0001).

# Alondra1 cloud API base URL (paths in openapi.yaml start with /v1). Local backend from alondra1-backend (docker compose up -d):
ALONDRA1_API_BASE_URL=http://127.0.0.1:8080
# Staging or production, e.g.:
# ALONDRA1_API_BASE_URL=https://api.example.com
